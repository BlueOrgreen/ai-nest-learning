# MySQL
MYSQL_ROOT_PASSWORD=your_secure_password
# 仅用于 MySQL 容器首次初始化时创建的默认库（可与业务库并存）
MYSQL_DATABASE=nest_db

# 各微服务实际连接的库（与本地 apps/user-service、apps/order-service/.env 一致）
USER_DB_DATABASE=nest_user_service
ORDER_DB_DATABASE=nest_order_service

# 首次部署 true 自动建表；表结构稳定后建议改为 false
DB_SYNCHRONIZE=true

# JWT（须与 web-nest src/lib/auth/jwt.ts 默认值一致）
JWT_SECRET=my-firstnest-secret-2026

# Frontend (sibling directory on server: /home/yunfan/web-nest)
WEB_NEST_PATH=../web-nest

# Gateway
CORS_ORIGINS=https://www.admin.chenchar.com,http://localhost:3000
USER_SERVICE_URL=http://user-service:3001
ORDER_SERVICE_URL=http://order-service:3002
